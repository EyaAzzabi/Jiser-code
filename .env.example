# Copy to .env and fill in. Never commit .env.

# --- IA ---
# Main provider (paid): OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Free backup (and main provider if no OpenAI key): Gemini, https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: force a model (empty = newest Flash model available for the key)
GEMINI_MODEL=
# Optional alternative provider: Claude (paid)
ANTHROPIC_API_KEY=
JISER_LLM_MODEL=claude-sonnet-5
# openai | gemini | anthropic (empty = openai, else gemini, else anthropic, depending on the keys set)
JISER_LLM_PROVIDER=
JISER_OFFLINE=0

# --- Database: Supabase (Project Settings > API) ---
SUPABASE_URL=
# service_role key: server-side only, never in the frontend
SUPABASE_SERVICE_KEY=

# --- n8n e-mail workflows (production webhook URLs after activating the workflows) ---
N8N_OTP_WEBHOOK_URL=
N8N_WELCOME_WEBHOOK_URL=
N8N_RAPPEL_WEBHOOK_URL=
# Long random string; also paste it in the n8n workflows (replace CHANGE_ME_SECRET)
N8N_SHARED_SECRET=

# --- Access ---
# Comma-separated e-mails allowed to open the private /plateforme space
ADMIN_EMAILS=
APP_URL=http://localhost:5173
# Administration accounts are expected to use an official address (others are flagged to the validator)
OFFICIAL_EMAIL_DOMAINS=finances.gov.tn
# Above this settlement amount (DT), a case officer's proposal must be approved by the head of centre
SEUIL_VALIDATION_CONCILIATION=100000

# --- Notifications (account decisions, message alerts, legal watch report) ---
N8N_NOTIF_WEBHOOK_URL=

# --- Confidentiality ---
# Fernet key for encryption at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is derived from SUPABASE_SERVICE_KEY. Never change it once data is stored.
JISER_DATA_KEY=
