      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "jiser-notification",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "61083e17-5692-4178-80b5-7d6a75f99574"
    },
    {
      "id": "0435cdc3-3fd5-44c4-9884-6b339dc58094",
      "name": "Secret valide ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "6260a22b-6be0-4efc-adf8-22b00c6d45fd",
              "leftValue": "={{ $json.headers['x-jiser-secret'] }}",
              "rightValue": "CHANGE_ME_SECRET",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "2a2a16fb-d775-4e32-ba4e-da567ee0d5cf",
      "name": "Envoyer la notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        480,
        -100
      ],
      "parameters": {
        "fromEmail": "JISER <no-reply@jiser.tn>",
        "toEmail": "={{ $('Webhook').item.json.body.email }}",
        "subject": "={{ $('Webhook').item.json.body.sujet }}",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;color:#1e293b;font-size:15px;line-height:1.6;max-width:560px;margin:auto;padding:16px\">\n<p style=\"font-size:20px;font-weight:bold;color:#0b2f5b;margin:0 0 4px\">JISER</p>\n<p style=\"color:#64748b;font-size:13px;margin:0 0 20px\">Plateforme d'accompagnement du contentieux fiscal</p>\n<h2 style=\"color:#0b2f5b;font-size:18px;margin:0 0 12px\">{{ $('Webhook').item.json.body.titre }}</h2><p>{{ $('Webhook').item.json.body.message }}</p>{{ ($('Webhook').item.json.body.lien || '').includes('localhost') ? '' : '<p><a href=\"' + $('Webhook').item.json.body.lien + '\" style=\"background:#0b2f5b;color:#ffffff;padding:10px 18px;border-radius:8px;text-decoration:none;font-weight:bold\">Ouvrir JISER</a></p>' }}<p>Cordialement,<br>L'équipe JISER</p>\n<hr style=\"border:none;border-top:1px solid #e2e8f0;margin:24px 0 12px\">\n<p style=\"color:#64748b;font-size:12px;margin:0\">Vous recevez ce message parce qu'une action a été effectuée avec votre adresse e-mail sur JISER.\nSi ce n'est pas vous, ignorez simplement ce message. L'équipe JISER ne vous demandera jamais votre code.</p>\n</div>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP JISER"
        }
      }
    },
    {
      "id": "47ceb90f-6154-4c3c-b812-94ca2f17ff0b",
      "name": "Réponse OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        -100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": true}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "526bfeda-ed8a-4090-8304-9b923d9e485b",
      "name": "Refusé",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": false}",
        "options": {
          "responseCode": 401
        }
      }
    }
  ],
  "connections": {
